{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c0015-run-ledger-schema-1.0",
  "title": "C0015 Run Ledger",
  "description": "Ground-truth run ledger for a single lab run. NEVER contains secrets: password/secret/key fields are forbidden by convention and rejected by scripts/lab_tools.py artifact-check.",
  "type": "object",
  "required": ["run_id", "scenario_id", "created_utc", "stages", "artifact_index"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{2,}$" },
    "scenario_id": { "type": "string", "pattern": "^C0015-LAB-[0-9]+$" },
    "created_utc": { "type": "string" },
    "secrets_policy": { "type": "string", "const": "no-secrets-allowed" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "host", "account", "status", "input_artifacts", "output_artifacts"],
        "additionalProperties": false,
        "properties": {
          "stage": { "type": "string", "pattern": "^S[0-9]+[ab]?$" },
          "host": { "type": "string" },
          "account": { "type": "string" },
          "status": { "enum": ["NOT RUN", "PARTIAL", "PASS", "SENSOR GAP", "INGEST/MAPPING GAP", "PREVENTED", "DENIED", "CHAIN BROKEN"] },
          "input_artifacts": { "type": "array", "items": { "type": "string" } },
          "output_artifacts": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "object", "required": ["kind"], "additionalProperties": true }
          },
          "rollback_status": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "artifact_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^ART-[0-9]{2}-[0-9]{2}$" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "producer_stage": { "type": "string" },
          "consumer_stage": { "type": "string" }
        }
      }
    }
  }
}
